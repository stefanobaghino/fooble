[Unit]
Description=fooble crawl, extract and index
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fooble
Group=fooble
WorkingDirectory=/opt/fooble/app
ExecStart=/opt/fooble/app/.venv/bin/fooble --data-dir /opt/fooble/data crawl
ExecStart=/opt/fooble/app/.venv/bin/fooble --data-dir /opt/fooble/data extract
ExecStart=/opt/fooble/app/.venv/bin/fooble --data-dir /opt/fooble/data index
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/fooble/app
ReadWritePaths=/opt/fooble/data
